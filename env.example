# Postgres (docker-compose)
POSTGRES_DB=planner
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner
POSTGRES_PORT=5432

# Redis (docker-compose)
REDIS_PORT=6379

# API (FastAPI)
API_PORT=8000
APP_RUNTIME_PROFILE=dev
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://planner:planner@postgres:5432/planner
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
STORAGE_ROOT=/data/uploads
STORAGE_BACKEND=local
# S3 backend (used when STORAGE_BACKEND=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
AUTH_MODE=bearer
AUTH_JWT_SECRET=change-me-for-production
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# Token lifetime for register/login JWTs (hours). Default 720 = 30 days.
# AUTH_JWT_TTL_HOURS=720
API_AUTH_MODE=bearer
NEXT_PUBLIC_API_AUTH_MODE=bearer
TELEMETRY_ENABLED=false
TELEMETRY_SERVICE_NAME=academic-os-api
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Worker: max parse/index attempts per background job before marking failed (default 3)
# WORKER_MAX_PARSE_ATTEMPTS=3

# Web (Next.js)
WEB_PORT=3000
# For browser/client-side calls:
# Local desktop: http://localhost:8000
# iPad/PWA homescreen tunnel (same-origin): /backend  — see docs/product/pwa-homescreen-beta.md
NEXT_PUBLIC_API_BASE_URL=/backend
# For server-side calls from inside the web container:
API_INTERNAL_BASE_URL=http://api:8000
# Optional override for next.config /backend rewrite target (defaults to API_INTERNAL_BASE_URL)
# API_PROXY_TARGET=http://api:8000
# Optional: same UUID as a row in users — sends X-User-Id so dashboard + client match (see README).
# NEXT_PUBLIC_DEV_USER_ID=
# DEV_USER_ID=
# Optional bearer token mode (used when AUTH_MODE=bearer). Prefer login UI; env token is shared.
# NEXT_PUBLIC_API_BEARER_TOKEN=
# API_BEARER_TOKEN=

# Optional dedicated secret for Canvas/integration tokens (falls back to AUTH_JWT_SECRET)
# INTEGRATIONS_SECRET=

# Canvas OAuth2 (developer key from your school Canvas admin)
# Redirect URI on the key must match CANVAS_OAUTH_REDIRECT_URI exactly.
# CANVAS_OAUTH_CLIENT_ID=
# CANVAS_OAUTH_CLIENT_SECRET=
CANVAS_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/canvas/oauth/callback
CANVAS_OAUTH_SUCCESS_URL=http://localhost:3000/courses?canvas=connected
CANVAS_OAUTH_FAILURE_URL=http://localhost:3000/courses?canvas=error
CANVAS_DEFAULT_BASE_URL=https://canvas.tamu.edu
# Optional space-separated scopes (required if the developer key enforces scopes)
# CANVAS_OAUTH_SCOPES=

# Google Drive OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client)
# Enable Google Drive API. Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Local API:
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google/oauth/callback
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:3000/oauth/done
GOOGLE_OAUTH_FAILURE_URL=http://localhost:3000/oauth/done
# Hosted / iPad (also add this exact redirect URI in Google Cloud Console):
# GOOGLE_OAUTH_REDIRECT_URI=https://app.mystudyflow.app/backend/integrations/google/oauth/callback
# GOOGLE_OAUTH_SUCCESS_URL=https://app.mystudyflow.app/oauth/done
# GOOGLE_OAUTH_FAILURE_URL=https://app.mystudyflow.app/oauth/done
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly

# Production baseline:
# APP_RUNTIME_PROFILE=prod
# APP_ENV=production
# AUTH_MODE=bearer
# AUTH_JWT_SECRET=<at-least-32-char-random-secret>
# RATE_LIMIT_ENABLED=true

# AI — Cursor Auto (Ask, Study Lab, handwriting)
# Create a key in Cursor Dashboard → Integrations / API.
# CURSOR_API_KEY=
# CURSOR_MODEL=auto
# Optional Teams/Enterprise router:
# CURSOR_MODEL=auto-smart
# CURSOR_OPTIMIZE_FOR=balanced
# Optional sandbox for local Cursor agents (defaults to /tmp/planner-cursor-agent):
# CURSOR_AGENT_CWD=/tmp/planner-cursor-agent

# Embeddings (optional; leave unset for keyword-only search/retrieval)
# OPENAI_API_KEY=   # only needed when EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_PROVIDER=openai
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# For local embeddings (large deps: torch), use:
# EMBEDDINGS_PROVIDER=sentence-transformers
# SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

